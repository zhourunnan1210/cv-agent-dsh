{
  "name": "@cv-research/mcp",
  "version": "0.0.0",
  "private": true,
  "description": "核心能力的 MCP 服务化封装（跨平台复用，文档 §12 Phase 0 Spike S5）。",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
