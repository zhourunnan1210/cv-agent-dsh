{
  "name": "cv-agent-dsh",
  "version": "0.0.0",
  "private": true,
  "description": "CV 自主科研 Agent 平台的 dsh 适配层：Cordis Service、defineTool 工具面、Agent Preset、Typed Event。",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./state": {
      "types": "./lib/state/service.d.ts",
      "default": "./lib/state/service.js"
    },
    "./state-tools": {
      "types": "./lib/state/tools.d.ts",
      "default": "./lib/state/tools.js"
    },
    "./orchestrator-guard": {
      "types": "./lib/state/orchestrator-guard.d.ts",
      "default": "./lib/state/orchestrator-guard.js"
    },
    "./instructions": {
      "types": "./lib/instructions.d.ts",
      "default": "./lib/instructions.js"
    },
    "./kb": {
      "types": "./lib/kb/service.d.ts",
      "default": "./lib/kb/service.js"
    },
    "./kb-tools": {
      "types": "./lib/kb/tools.d.ts",
      "default": "./lib/kb/tools.js"
    },
    "./kb-extract": {
      "types": "./lib/kb/extract-tool.d.ts",
      "default": "./lib/kb/extract-tool.js"
    },
    "./kb-entries": {
      "types": "./lib/kb/entry-tools.d.ts",
      "default": "./lib/kb/entry-tools.js"
    },
    "./kb-research": {
      "types": "./lib/kb/research-tools.d.ts",
      "default": "./lib/kb/research-tools.js"
    },
    "./mineru-quota": {
      "types": "./lib/kb/mineru-quota-service.d.ts",
      "default": "./lib/kb/mineru-quota-service.js"
    },
    "./idea-score": {
      "types": "./lib/scoring/service.d.ts",
      "default": "./lib/scoring/service.js"
    },
    "./write-draft": {
      "types": "./lib/writing/tools.d.ts",
      "default": "./lib/writing/tools.js"
    },
    "./domain-tools": {
      "types": "./lib/domain/tools.d.ts",
      "default": "./lib/domain/tools.js"
    },
    "./mcp": {
      "types": "./lib/mcp/kb-adapter.d.ts",
      "default": "./lib/mcp/kb-adapter.js"
    },
    "./idea-tools": {
      "types": "./lib/scoring/tools.d.ts",
      "default": "./lib/scoring/tools.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "prepare": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@cv-research/core": "workspace:*",
    "fflate": "^0.8.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-credentials": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6",
    "@deepseek-ai/schemastery": ">=3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/node": "^22.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.8"
  }
}
