# 依赖
node_modules/
.pnpm-store/
.pnpm-home/

# 构建产物
dist/
*.tsbuildinfo
# vendored 上游包：源码入库，lib/ 由 pnpm install 的 prepare 脚本现场构建
packages/vendor/*/lib/
# 本仓库各包的 lib/ 同样是 prepare 现场构建的产物，不入库
packages/core/lib/
packages/dsh-plugin/lib/
packages/mcp-server/lib/

# 运行期数据（文档 §11：data/ 整体 gitignore；三库 SQLite 走回滚快照而非 git）
data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.db

# 密钥：禁止进入 git 与原模型上下文（文档 §11、§23）
.env
.env.*
!.env.example
*.credentials.yaml
.credentials.yaml

# 本地实验与临时产物
.tmp/
tmp/
*.log
logs/
# Python 字节码（skill 里的 .py 脚本跑一次就会生成）
__pycache__/
*.pyc
# 隔离的 DSH_HOME（用于在不影响运行中宿主的前提下做 bundle 装载验证）
.spike-dsh-home/

# 编辑器 / 操作系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 临时/实验脚本：_ 前缀是约定，不进版本控制（脚本本体留在磁盘上）
scripts/_*

# 第三方 skill 中许可为 CC BY-NC 4.0 的部分（禁止商业使用，与 MIT 不兼容）
# 见 NOTICE.md：开源发布前必须移除。能力不受影响，按需自行安装。
.dsh/skills/academic-*/
.dsh/skills/deep-research/
.dsh/skills/shared/
