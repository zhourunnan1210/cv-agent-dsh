# dsh 生态对齐：pnpm workspace
# 说明：本机 pnpm 由 npm 全局安装，sandbox 不允许写 %LOCALAPPDATA%\pnpm；
# 因此把 pnpm 自身的状态目录与 store 一并留在工作区内（见 .pnpm-home/，已 gitignore）。
# 若在无 sandbox 限制的环境（CI / 云 GPU 机器）使用，可删除这三行。
global-dir=.pnpm-home/global
state-dir=.pnpm-home/state
store-dir=.pnpm-home/store
shamefully-hoist=false
strict-peer-dependencies=false
